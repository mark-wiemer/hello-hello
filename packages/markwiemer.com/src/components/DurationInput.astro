---
import TextInput from "@/components/TextInput.astro";

interface Props {
  id: string;
  name: string;
  label: string;
  value: string;
}

const { id, name, label, value } = Astro.props;
---

<div class="duration-input">
  <TextInput
    id={id}
    name={name}
    label={label}
    pattern="[0-5][0-9]:[0-5][0-9]"
    value={value}
    required
  />
</div>

<style>
  .duration-input {
    align-self: start;
  }
</style>
